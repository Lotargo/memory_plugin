# Dependencies
**/node_modules/**
**/package-lock.json
mcp-server/package.json

# Tests, benchmarks, and scratch scripts
# mcp-server/ has its own .npmignore because package.json explicitly publishes that directory.

# Dev docs, assets, website, exports, and local databases
dev_docs/
docs/
assets/
website/
scripts/
exports/
*.db
local_test.db
*.log

# Defense in depth: never package user profiles, credentials or generated state.
**/.env
**/.env.*
**/*.sqlite*
**/*.db
**/*.log
**/*.tgz
**/*.bak
**/*.enc
**/connection.json
**/config.json
**/auth_secrets*
**/node_modules/**

# Git
.git/
.gitignore
