<div class="memory-matrix" data-memory-matrix aria-label="Memory layers visualization">
  <div class="matrix-cell matrix-hot" data-cell="hot" data-neighbors="rag vector" data-idle="true" style="--cell-accent:#ffbd19;--reveal-delay:0ms"><span class="eyebrow">HOT MEMORY</span><strong>facts</strong><small>always available</small></div>
  <div class="matrix-cell matrix-rag" data-cell="rag" data-neighbors="hot project persona" data-idle="true" style="--cell-accent:#ee210b;--reveal-delay:55ms"><span class="eyebrow">RAG</span><strong>knowledge</strong><small>on demand</small></div>
  <div class="matrix-cell matrix-project" data-cell="project" data-neighbors="rag persona sync warm" data-idle="true" style="--cell-accent:#ffbd19;--reveal-delay:110ms"><span class="eyebrow">PROJECT</span><strong>git scope</strong><small>follows identity</small></div>
  <div class="matrix-cell matrix-persona" data-cell="persona" data-neighbors="rag project vector deep sync" data-idle="true" style="--cell-accent:#168de2;--reveal-delay:165ms"><span class="eyebrow">PERSONA</span><strong>directives</strong><small>shared across agents</small></div>
  <div class="matrix-cell matrix-vector" data-cell="vector" data-neighbors="hot persona" data-idle="true" style="--cell-accent:#ffbd19;--reveal-delay:220ms"><span class="eyebrow">RETRIEVAL</span><strong>hybrid</strong><small>FTS5 + vectors</small></div>
  <div class="matrix-cell matrix-sync" data-cell="sync" data-neighbors="project persona deep warm" data-idle="true" style="--cell-accent:#c90031;--reveal-delay:275ms"><span class="eyebrow">SYNC</span><strong>portable</strong><small>optional cloud</small></div>
  <div class="matrix-cell matrix-deep" data-cell="deep" data-neighbors="persona sync" aria-hidden="true" style="--cell-accent:#ffbd19;--reveal-delay:330ms"></div>
  <div class="matrix-cell matrix-warm" data-cell="warm" data-neighbors="project sync" aria-hidden="true" style="--cell-accent:#ffbd19;--reveal-delay:385ms"></div>
</div>

<style>
  .memory-matrix {
    position: relative;
    isolation: isolate;
  }

  .matrix-cell {
    position: relative;
    overflow: hidden;
    will-change: transform, filter;
    transition:
      transform 260ms cubic-bezier(.2,.75,.2,1),
      filter 220ms ease,
      box-shadow 220ms ease;
  }

  .matrix-cell::before {
    content: '';
    position: absolute;
    z-index: 6;
    top: 0;
    left: 0;
    width: 4px;
    height: 100%;
    background: var(--cell-accent, #ffbd19);
    transform: scaleY(0);
    transform-origin: 50% 100%;
    transition: transform 220ms cubic-bezier(.2,.75,.2,1);
    pointer-events: none;
  }

  .matrix-cell::after {
    content: '';
    position: absolute;
    z-index: 5;
    inset: 0;
    border: 1px solid transparent;
    pointer-events: none;
  }

  .matrix-cell > span,
  .matrix-cell > strong,
  .matrix-cell > small {
    position: relative;
    z-index: 2;
    transition:
      transform 240ms cubic-bezier(.2,.75,.2,1),
      opacity 180ms ease;
  }

  .memory-matrix.has-active .matrix-cell:not(.is-active):not(.is-neighbor) {
    filter: brightness(.94) saturate(.88);
  }

  .memory-matrix.has-active .matrix-cell.is-active {
    z-index: 4;
    transform: translate3d(0,-4px,0) scale(.998);
    filter: brightness(1.065) saturate(1.04);
    box-shadow: 0 12px 26px rgba(20, 4, 0, .16);
  }

  .memory-matrix.has-active .matrix-cell.is-active::before {
    transform: scaleY(1);
    transform-origin: 50% 0%;
  }

  .memory-matrix.has-active .matrix-cell.is-active > span,
  .memory-matrix.has-active .matrix-cell.is-active > strong,
  .memory-matrix.has-active .matrix-cell.is-active > small {
    transform: translateX(6px);
  }

  .memory-matrix.has-active .matrix-cell.is-neighbor {
    z-index: 3;
    transform: translate3d(var(--neighbor-x,0),var(--neighbor-y,0),0);
    filter: brightness(1.015) saturate(.98);
  }

  .matrix-cell.is-pulse-origin::after {
    animation: matrix-origin-pulse 620ms cubic-bezier(.2,.75,.2,1) both;
  }

  .matrix-cell.is-pulse-target::after {
    animation: matrix-target-pulse 520ms cubic-bezier(.2,.75,.2,1) both;
  }

  .matrix-cell.is-idle-pulse::before {
    animation: matrix-idle-edge 760ms cubic-bezier(.2,.75,.2,1) both;
  }

  .memory-matrix.motion-armed .matrix-cell {
    opacity: 0;
    transform: translateY(12px) scale(.985);
    clip-path: inset(0 0 18% 0);
  }

  .memory-matrix.motion-armed.is-ready .matrix-cell {
    animation: matrix-build 520ms cubic-bezier(.2,.75,.2,1) both;
    animation-delay: var(--reveal-delay,0ms);
  }

  @keyframes matrix-build {
    0% { opacity: 0; transform: translateY(12px) scale(.985); clip-path: inset(0 0 18% 0); }
    65% { opacity: 1; }
    100% { opacity: 1; transform: translateY(0) scale(1); clip-path: inset(0); }
  }

  @keyframes matrix-origin-pulse {
    0% { border-color: transparent; box-shadow: inset 0 0 0 0 transparent; }
    34% { border-color: color-mix(in srgb, var(--cell-accent, #ffbd19) 74%, white 26%); box-shadow: inset 0 0 0 1px rgba(255,255,255,.15); }
    100% { border-color: transparent; box-shadow: inset 0 0 0 0 transparent; }
  }

  @keyframes matrix-target-pulse {
    0% { border-color: transparent; }
    48% { border-color: color-mix(in srgb, var(--cell-accent, #ffbd19) 54%, white 46%); }
    100% { border-color: transparent; }
  }

  @keyframes matrix-idle-edge {
    0%,100% { transform: scaleY(0); transform-origin: 50% 100%; }
    38%,62% { transform: scaleY(1); transform-origin: 50% 0%; }
  }

  /* Keep the desktop mosaic edge-to-edge: Hot Memory and Persona must meet,
     not occupy the same grid column. Mobile has its own two-column layout. */
  @media (min-width: 821px) {
    .matrix-hot { grid-column: 1 / 4; }
    .matrix-rag { grid-column: 4 / 8; }
  }

  @media (max-width: 560px) {
    .memory-matrix.has-active .matrix-cell.is-active,
    .memory-matrix.has-active .matrix-cell.is-neighbor {
      transform: none;
    }

    .memory-matrix.has-active .matrix-cell.is-active > span,
    .memory-matrix.has-active .matrix-cell.is-active > strong,
    .memory-matrix.has-active .matrix-cell.is-active > small {
      transform: translateX(3px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .matrix-cell,
    .matrix-cell::before,
    .matrix-cell::after,
    .matrix-cell > span,
    .matrix-cell > strong,
    .matrix-cell > small {
      animation: none !important;
      transition: none !important;
    }

    .memory-matrix.motion-armed .matrix-cell {
      opacity: 1;
      transform: none;
      clip-path: none;
    }

    .memory-matrix.has-active .matrix-cell.is-active,
    .memory-matrix.has-active .matrix-cell.is-neighbor,
    .memory-matrix.has-active .matrix-cell.is-active > span,
    .memory-matrix.has-active .matrix-cell.is-active > strong,
    .memory-matrix.has-active .matrix-cell.is-active > small {
      transform: none;
    }
  }
</style>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll('[data-memory-matrix]').forEach((matrixNode) => {
    const matrix = matrixNode;
    if (!(matrix instanceof HTMLElement)) return;

    const cells = Array.from(matrix.querySelectorAll('[data-cell]')).filter((cell): cell is HTMLElement => cell instanceof HTMLElement);
    const idleCells = cells.filter((cell) => cell instanceof HTMLElement && cell.dataset.idle === 'true');
    let idleTimer = 0;
    let pulseTimers: number[] = [];
    let idleIndex = 0;
    let activeCell: HTMLElement | null = null;

    const clearPulseTimers = () => {
      pulseTimers.forEach((timer) => window.clearTimeout(timer));
      pulseTimers = [];
    };

    const clearPulseClasses = () => {
      cells.forEach((cell) => {
        cell.classList.remove('is-pulse-origin', 'is-pulse-target', 'is-idle-pulse');
      });
    };

    const neighborCells = (origin: HTMLElement): HTMLElement[] => {
      const keys = (origin.dataset.neighbors || '').split(/\s+/).filter(Boolean);
      return keys
        .map((key) => matrix.querySelector(`[data-cell="${key}"]`))
        .filter((cell): cell is HTMLElement => cell instanceof HTMLElement);
    };

    const setNeighborNudges = (origin: HTMLElement, neighbors: HTMLElement[]) => {
      const originRect = origin.getBoundingClientRect();
      const originX = originRect.left + originRect.width / 2;
      const originY = originRect.top + originRect.height / 2;

      neighbors.forEach((neighbor) => {
        const rect = neighbor.getBoundingClientRect();
        const dx = rect.left + rect.width / 2 - originX;
        const dy = rect.top + rect.height / 2 - originY;
        const x = Math.abs(dx) > 8 ? Math.sign(dx) * 3 : 0;
        const y = Math.abs(dy) > 8 ? Math.sign(dy) * 3 : 0;
        neighbor.style.setProperty('--neighbor-x', `${x}px`);
        neighbor.style.setProperty('--neighbor-y', `${y}px`);
      });
    };

    const pulseFrom = (origin: HTMLElement, idle = false) => {
      if (reducedMotion.matches) return;
      clearPulseTimers();
      clearPulseClasses();

      const neighbors = neighborCells(origin);
      origin.classList.add('is-pulse-origin');
      if (idle) origin.classList.add('is-idle-pulse');

      neighbors.forEach((neighbor, index) => {
        pulseTimers.push(window.setTimeout(() => {
          neighbor.classList.add('is-pulse-target');
        }, 90 + index * 70));
      });

      pulseTimers.push(window.setTimeout(clearPulseClasses, 820));
    };

    const clearActive = () => {
      activeCell = null;
      matrix.classList.remove('has-active');
      cells.forEach((cell) => {
        cell.classList.remove('is-active', 'is-neighbor');
        cell.style.removeProperty('--neighbor-x');
        cell.style.removeProperty('--neighbor-y');
      });
      clearPulseTimers();
      clearPulseClasses();
      scheduleIdle();
    };

    const activate = (origin: HTMLElement) => {
      if (activeCell === origin) return;
      window.clearTimeout(idleTimer);
      activeCell = origin;
      matrix.classList.add('has-active');

      cells.forEach((cell) => cell.classList.remove('is-active', 'is-neighbor'));
      origin.classList.add('is-active');
      const neighbors = neighborCells(origin);
      setNeighborNudges(origin, neighbors);
      neighbors.forEach((neighbor) => neighbor.classList.add('is-neighbor'));
      pulseFrom(origin);
    };

    const scheduleIdle = () => {
      window.clearTimeout(idleTimer);
      if (reducedMotion.matches || activeCell || document.hidden || idleCells.length === 0) return;
      idleTimer = window.setTimeout(() => {
        const origin = idleCells[idleIndex % idleCells.length];
        idleIndex += 1;
        if (origin) pulseFrom(origin, true);
        scheduleIdle();
      }, 6800 + Math.random() * 2200);
    };

    cells.forEach((cell) => {
      cell.addEventListener('pointerenter', () => activate(cell));
    });

    matrix.addEventListener('pointerleave', clearActive);

    if (!reducedMotion.matches) {
      matrix.classList.add('motion-armed');
      const observer = new IntersectionObserver((entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          matrix.classList.add('is-ready');
          observer.disconnect();
          window.setTimeout(() => matrix.classList.remove('motion-armed'), 1100);
          window.setTimeout(scheduleIdle, 1350);
        }
      }, { threshold: 0.16 });
      observer.observe(matrix);
    } else {
      matrix.classList.add('is-ready');
    }

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        window.clearTimeout(idleTimer);
        clearPulseTimers();
        clearPulseClasses();
      } else {
        scheduleIdle();
      }
    });

    reducedMotion.addEventListener('change', () => {
      if (reducedMotion.matches) {
        window.clearTimeout(idleTimer);
        clearActive();
        matrix.classList.remove('motion-armed');
        matrix.classList.add('is-ready');
      } else {
        scheduleIdle();
      }
    });
  });
</script>
