---
import BrandMark from './BrandMark.astro';
import BrandIcon from './BrandIcon.astro';
---
<header class="site-header">
  <a class="brand" href="#top" aria-label="memory_plugin home">
    <BrandMark class="brand-mark-v3" />
    <span>memory_plugin</span>
  </a>
  <nav class="desktop-nav" aria-label="Primary navigation">
    <a href="#features">Features</a>
    <a href="#architecture">Architecture</a>
    <a href="#clients">Clients</a>
    <a href="#security">Local first</a>
  </nav>
  <div class="header-actions">
    <a class="header-link brand-link hide-small" href="https://www.npmjs.com/package/@lotargo/memory_plugin" target="_blank" rel="noreferrer"><BrandIcon name="npm" class="brand-icon npm-icon" /><span>npm</span><span aria-hidden="true">↗</span></a>
    <a class="header-link brand-link hide-small" href="https://github.com/Lotargo/memory_plugin" target="_blank" rel="noreferrer"><BrandIcon name="github" class="brand-icon" /><span>GitHub</span><span aria-hidden="true">↗</span></a>
    <a class="header-cta" href="#features">Explore <span>↓</span></a>
  </div>
</header>
