---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'memory_plugin — persistent memory for AI agents',
  description = 'Local-first persistent memory, hybrid RAG, and agent personalization for AI coding agents.'
} = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#0d0d0f" />
  <title>{title}</title>
</head>
<body><slot /></body>
</html>
