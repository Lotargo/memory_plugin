{
  "name": "@lotargo/memory_plugin",
  "version": "1.7.2",
  "description": "Local-first memory, hybrid RAG, and agent personalization for AI coding agents (OpenCode, Claude Code, Codex, Gemini CLI, Antigravity). MCP server + CLI with persistent context, document ingestion, vector + SQLite FTS5 retrieval, sync, setup, and safe uninstall.",
  "type": "module",
  "main": "opencode-plugin/main.js",
  "scripts": {
    "preinstall": "node mcp-server/preinstall.js || true",
    "postinstall": "node mcp-server/postinstall.js",
    "dev:link": "node mcp-server/cli_boot.js dev-link",
    "persona:sync": "node mcp-server/cli_boot.js sync-persona",
    "persona:migrate": "node mcp-server/cli_boot.js migrate-persona",
    "test": "node tests/run_all.js",
    "check:package": "node scripts/check-package.mjs",
    "smoke:package": "node scripts/smoke-package.mjs",
    "vendor:docx": "node scripts/update-docx-vendor.mjs",
    "smoke:models": "node tests/smoke/dependency_models.test.js",
    "smoke:marketplace": "node tests/smoke/marketplace_security.test.js",
    "release:check": "npm run check:package && npm audit --omit=dev --audit-level=low && npm test",
    "prepublishOnly": "npm run release:check",
    "test:rag": "node tests/unit/rag_evaluation.test.js",
    "smoke": "node tests/smoke/e2e_real_embeddings.test.js",
    "benchmark": "node mcp-server/benchmarks/run_benchmarks.js",
    "benchmark:table-code": "node mcp-server/benchmarks/table_code_retrieval.js"
  },
  "bin": {
    "memory-plugin": "mcp-server/boot.js",
    "memory_plugin": "mcp-server/boot.js",
    "memory-agent": "mcp-server/boot.js",
    "memory-cli": "mcp-server/cli_boot.js"
  },
  "files": [
    "npm-shrinkwrap.json",
    "CHANGELOG.md",
    "README.md",
    "MARKETPLACE.md",
    "LICENSE",
    "opencode-plugin",
    "mcp-server",
    "skills"
  ],
  "keywords": [
    "memory",
    "persistent-memory",
    "long-term-memory",
    "ai-memory",
    "agent-memory",
    "memory-plugin",
    "ai-agent",
    "ai-agents",
    "coding-agent",
    "coding-agents",
    "ai-coding-agents",
    "agent-persona",
    "ai-personalization",
    "context-engineering",
    "local-first",
    "rag",
    "knowledge-base",
    "llm",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "mcp-tools",
    "opencode",
    "claude-code",
    "codex",
    "gemini-cli",
    "antigravity",
    "google-jules",
    "plugin",
    "developer-tools",
    "vector-search",
    "hybrid-search",
    "semantic-search",
    "embeddings",
    "sqlite",
    "fts5",
    "context"
  ],
  "author": "Lotargo",
  "license": "MIT",
  "engines": {
    "node": "^22.16.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Lotargo/memory_plugin.git"
  },
  "homepage": "https://github.com/Lotargo/memory_plugin#readme",
  "bugs": {
    "url": "https://github.com/Lotargo/memory_plugin/issues"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "@libsql/client": "^0.17.4",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@xmldom/xmldom": "0.8.15",
    "base64-js": "1.5.1",
    "dingbat-to-unicode": "1.0.1",
    "dompurify": "3.4.16",
    "jszip": "^3.10.2",
    "katex": "0.19.0",
    "lop": "0.4.2",
    "marked": "18.0.14",
    "mermaid": "12.2.0",
    "pdf-parse": "^2.4.5",
    "underscore": "1.13.8",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "xmlbuilder": "10.1.1",
    "zod": "^4.1.0"
  }
}
