{
  "name": "@lotargo/memory_plugin",
  "version": "1.6.8",
  "description": "Local-first memory, hybrid RAG, and agent personalization for AI coding agents (OpenCode, Claude Code, Codex, Gemini CLI, Antigravity). MCP server + CLI with persistent context, document ingestion, vector + SQLite FTS5 retrieval, sync, setup, and safe uninstall.",
  "type": "module",
  "main": "opencode-plugin/main.js",
  "scripts": {
    "preinstall": "node mcp-server/preinstall.js || true",
    "dev:link": "node mcp-server/cli_boot.js dev-link",
    "persona:sync": "node mcp-server/cli_boot.js sync-persona",
    "persona:migrate": "node mcp-server/cli_boot.js migrate-persona",
    "test": "node tests/run_all.js",
    "test:rag": "node tests/unit/rag_evaluation.test.js",
    "smoke": "node tests/smoke/e2e_real_embeddings.test.js",
    "benchmark": "node mcp-server/benchmarks/run_benchmarks.js",
    "benchmark:table-code": "node mcp-server/benchmarks/table_code_retrieval.js"
  },
  "bin": {
    "memory_plugin": "mcp-server/boot.js",
    "memory-agent": "mcp-server/boot.js",
    "memory-cli": "mcp-server/cli_boot.js"
  },
  "files": [
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "opencode-plugin",
    "mcp-server",
    "skills"
  ],
  "keywords": [
    "memory",
    "persistent-memory",
    "long-term-memory",
    "ai-memory",
    "agent-memory",
    "memory-plugin",
    "ai-agent",
    "ai-agents",
    "coding-agent",
    "coding-agents",
    "ai-coding-agents",
    "agent-persona",
    "ai-personalization",
    "context-engineering",
    "local-first",
    "rag",
    "knowledge-base",
    "llm",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "mcp-tools",
    "opencode",
    "claude-code",
    "codex",
    "gemini-cli",
    "antigravity",
    "google-jules",
    "plugin",
    "developer-tools",
    "vector-search",
    "hybrid-search",
    "semantic-search",
    "embeddings",
    "sqlite",
    "fts5",
    "context"
  ],
  "author": "Lotargo",
  "license": "MIT",
  "engines": {
    "node": ">=22.5.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Lotargo/memory_plugin.git"
  },
  "homepage": "https://github.com/Lotargo/memory_plugin#readme",
  "bugs": {
    "url": "https://github.com/Lotargo/memory_plugin/issues"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.3.3",
    "@libsql/client": "^0.17.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.1.0"
  }
}
